# AssemblyAI API Key
# Get one at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_api_key_here

# Deepgram API Key (for more accurate transcription)
# Get one at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_api_key_here

# Kimi Code API Key (for transcript analysis)
# Get one at https://www.kimi.com/code/console
KIMI_CODE_API_KEY=your_api_key_here

# Optional yt-dlp authentication for videos requiring login (Netscape format)
# TRANSCRIPTS_COOKIES_FILE=/absolute/path/to/cookies.txt
